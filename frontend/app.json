{
  "expo": {
    "name": "LRI FERTILIZER",
    "slug": "SoilTrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/app-icon-round.png",
    "splash": {
      "image": "./assets/app-icon-round.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gkvk.soilapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rishven.soiltrack",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-round.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LRI FERTILIZER App to access your camera for capturing LRI card images.",
          "recordAudioPermission": "Allow LRI FERTILIZER App to access your microphone for recording during card capture."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LRI FERTILIZER App to access your photos to select LRI card images."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "SoilTrack",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "40102f12-0886-4b58-acbe-d86c0848bfa0"
      }
    }
  }
}