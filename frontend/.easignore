# EAS Build Ignore File
# Ignore node_modules and package manager files
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Ignore Expo and local build directories
.expo/
dist/
web-build/

# Ignore native directories
android/
ios/

# Ignore backend folder since we are building the frontend React Native app
backend/
../backend/

# Ignore IDE settings
.vscode/
.idea/

# Ignore system/temp files
.DS_Store
Thumbs.db
*.log
*.tmp

# Ignore local environment files (sensitive credentials should be set in EAS secrets)
.env
.env.local
.env.*.local
.env.production
.env.development
.env.staging
